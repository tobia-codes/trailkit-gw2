#!/bin/sh
# Checks before every push (ROADMAP R14, R48). Enable with `cargo xtask install-hooks`.
set -e
# Git passes one line per ref: local ref, local sha, remote ref, remote sha.
# Every destination is checked, not only the current branch (Q460):
# - a branch must be a work branch (feature/, chore/, bugfix/, hotfix/ with a
#   kebab-case name); develop and main are never pushed to or deleted;
# - a tag needs the user's explicit OK each time (AGENTS.md rule 1), so it is
#   refused unless TRAILKIT_ALLOW_TAG_PUSH=1 is set for that one push (Q461);
# - deleting another remote branch needs no checks.
zero=0000000000000000000000000000000000000000
branches=""
while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/develop | refs/heads/main)
            echo "Error: pushing to or deleting $remote_ref is not allowed; open a pull request" >&2
            exit 1
            ;;
        refs/tags/*)
            if [ "${TRAILKIT_ALLOW_TAG_PUSH:-}" != 1 ]; then
                echo "Error: pushing $remote_ref needs the user's OK; then push with TRAILKIT_ALLOW_TAG_PUSH=1" >&2
                exit 1
            fi
            ;;
        refs/heads/*)
            [ "$local_sha" = "$zero" ] || branches="$branches ${remote_ref#refs/heads/}"
            ;;
        *)
            echo "Error: pushing $remote_ref is not allowed" >&2
            exit 1
            ;;
    esac
done
# Only deletions or approved tags: nothing is built.
[ -n "$branches" ] || exit 0

# Shells started by git may not have rustup on PATH.
command -v cargo >/dev/null 2>&1 || . "$HOME/.cargo/env"
# The Cargo workspace lives in `rust/` (ROADMAP R116).
cd "$(git rev-parse --show-toplevel)/rust"
for branch in $branches; do
    cargo xtask check-branch --head "$branch"
done
cargo clippy --quiet --workspace --all-targets -- -D warnings
cargo test --quiet --workspace
# The addon UI is `#[cfg(windows)]`; lint it for the real target too, so CI
# does not find it first (R70). Needs cargo-xwin.
cargo xwin clippy --quiet --target x86_64-pc-windows-msvc --workspace --all-targets -- -D warnings
